---
import { basePath } from '@/utils/base';

const onHomePage = Astro.url.pathname === basePath || Astro.url.pathname === `${basePath}index.html`;
const home = onHomePage ? '' : basePath;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="wordmark" href={basePath} aria-label="Ruibin Chen, home">
      <span class="wordmark-mark" aria-hidden="true">RC</span>
      <span>Ruibin Chen</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href={`${home}#work`}>Work</a>
      <a href={`${home}#publications`}>Research</a>
      <a href={`${home}#experience`}>Experience</a>
      <a href={`${basePath}resume/`}>Résumé</a>
    </nav>
    <div class="header-actions">
      <a class="contact-link" href={`${home}#contact`}>Let’s connect</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch color theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z"/></svg>
      </button>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" data-mobile-menu aria-label="Mobile navigation" hidden>
    <a href={`${home}#work`}>Selected work</a>
    <a href={`${home}#publications`}>Research & publications</a>
    <a href={`${home}#experience`}>Experience & education</a>
    <a href={`${basePath}resume/`}>Résumé</a>
    <a href={`${home}#contact`}>Contact</a>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  menuButton?.addEventListener('click', () => {
    const expanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!expanded));
    menuButton.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
    if (mobileMenu) mobileMenu.hidden = expanded;
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open menu');
    if (mobileMenu) mobileMenu.hidden = true;
  }));
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid transparent; background: color-mix(in srgb, var(--background) 86%, transparent); backdrop-filter: blur(16px); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 4.6rem; }
  .wordmark { display: inline-flex; align-items: center; gap: .7rem; color: var(--text); font-weight: 720; letter-spacing: -.02em; text-decoration: none; }
  .wordmark-mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .5rem; background: var(--text); color: var(--background); font-family: var(--font-mono); font-size: .65rem; letter-spacing: -.02em; }
  nav { display: flex; align-items: center; gap: 1.8rem; }
  nav a { color: var(--text-muted); font-size: .88rem; font-weight: 600; text-decoration: none; }
  nav a:hover { color: var(--text); }
  .header-actions { display: flex; align-items: center; gap: .8rem; }
  .contact-link { padding: .62rem .9rem; border: 1px solid var(--border-strong); border-radius: .45rem; color: var(--text); font-size: .8rem; font-weight: 700; text-decoration: none; }
  .theme-toggle, .menu-toggle { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; padding: 0; border: 1px solid var(--border); border-radius: .45rem; background: var(--surface-raised); color: var(--text); cursor: pointer; }
  .theme-toggle svg { width: 1rem; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle .moon { display: none; }
  :global([data-theme='dark']) .theme-toggle .sun { display: none; }
  :global([data-theme='dark']) .theme-toggle .moon { display: block; }
  .menu-toggle, .mobile-menu { display: none; }
  .menu-toggle span { display: block; width: 1rem; height: 1px; margin: 2px 0; background: currentColor; }

  @media (max-width: 820px) {
    .header-inner > nav, .contact-link { display: none; }
    .menu-toggle { display: block; }
    .mobile-menu:not([hidden]) { display: grid; gap: 0; padding: .5rem var(--container-pad) 1rem; border-top: 1px solid var(--border); background: var(--background); }
    .mobile-menu a { padding: .9rem 0; border-bottom: 1px solid var(--border); color: var(--text); }
  }
</style>
