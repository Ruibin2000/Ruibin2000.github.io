---
import type { Project } from '@/data/projects';
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="project-card" id={project.slug}>
  <div class="project-image">
    <ProjectVisual type={project.visual} title={project.title} />
    <span class:list={['status', project.status.toLowerCase().replaceAll(' ', '-')]}> 
      <span aria-hidden="true"></span>{project.status}
    </span>
  </div>
  <div class="project-body">
    <p class="project-index">0{index + 1} / {project.eyebrow}</p>
    <div class="project-title-row">
      <h3>{project.title}</h3>
      <span class="project-period">{project.period}</span>
    </div>
    <p class="project-description">{project.description}</p>
    <ul class="tag-list" aria-label="Technologies used">
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    {project.link ? (
      <a class="text-link" href={project.link.href}>{project.link.label}<span aria-hidden="true"> ↗</span></a>
    ) : (
      <span class="pending-link" title="TODO: add a verified project URL">{project.pendingLink}</span>
    )}
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-sm);
  }

  .project-image {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100%;
    padding: 1.25rem;
    background: var(--surface-technical);
    border-right: 1px solid var(--border);
  }

  .status {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .45rem .7rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-raised) 90%, transparent);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .07em;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .status span {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .status.ongoing span { background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .status.completed span { background: var(--success); }
  .status.status-to-confirm span { background: var(--warning); }

  .project-body { padding: clamp(1.5rem, 4vw, 2.4rem); }
  .project-index { color: var(--accent-strong); font-family: var(--font-mono); font-size: .73rem; letter-spacing: .07em; text-transform: uppercase; }
  .project-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-top: .8rem; }
  .project-title-row h3 { max-width: 19ch; font-size: clamp(1.35rem, 2.5vw, 1.9rem); }
  .project-period { flex: none; margin-top: .35rem; color: var(--text-subtle); font-family: var(--font-mono); font-size: .72rem; }
  .project-description { margin-top: 1rem; color: var(--text-muted); line-height: 1.7; }
  .tag-list { display: flex; flex-wrap: wrap; gap: .45rem; margin: 1.3rem 0 1.4rem; padding: 0; list-style: none; }
  .tag-list li { padding: .35rem .62rem; border: 1px solid var(--border); border-radius: .35rem; color: var(--text-muted); font-family: var(--font-mono); font-size: .72rem; }
  .pending-link { color: var(--text-subtle); font-family: var(--font-mono); font-size: .78rem; }

  @media (max-width: 760px) {
    .project-card { grid-template-columns: 1fr; }
    .project-image { border-right: 0; border-bottom: 1px solid var(--border); }
    .project-title-row { display: block; }
    .project-period { display: block; margin-top: .65rem; }
  }
</style>
