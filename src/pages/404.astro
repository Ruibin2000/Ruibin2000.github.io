---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { basePath } from '@/utils/base';
---

<BaseLayout title="Page not found · Ruibin Chen" description="The requested page could not be found." noindex={true}>
  <section class="not-found">
    <div class="container not-found-inner">
      <div class="error-code" aria-hidden="true"><span>4</span><svg viewBox="0 0 180 180"><circle cx="90" cy="90" r="60"/><path d="M24 109c37-65 92-65 132 0"/><circle cx="90" cy="90" r="8"/></svg><span>4</span></div>
      <p class="eyebrow">Signal lost</p>
      <h1>This path is out of range.</h1>
      <p>The page may have moved, or the link may be incomplete.</p>
      <a href={basePath}>Return to the portfolio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { display: grid; place-items: center; min-height: 72svh; text-align: center; }
  .not-found-inner { max-width: 52rem; }
  .error-code { display: flex; align-items: center; justify-content: center; color: var(--text); font-size: clamp(6rem, 18vw, 12rem); font-weight: 750; letter-spacing: -.1em; line-height: 1; }
  .error-code svg { width: clamp(5rem, 14vw, 9rem); margin-inline: -.4rem .6rem; fill: none; stroke: var(--accent); stroke-width: 2; }
  .not-found h1 { margin-top: 1rem; font-size: clamp(2.3rem, 7vw, 5rem); }
  .not-found p:not(.eyebrow) { margin-top: 1rem; color: var(--text-muted); }
  .not-found a { display: inline-flex; margin-top: 2rem; padding: .8rem 1.1rem; border-radius: .45rem; background: var(--text); color: var(--background); font-size: .85rem; font-weight: 750; text-decoration: none; }
</style>
