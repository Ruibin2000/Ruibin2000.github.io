---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';
import { projects } from '@/data/projects';
import { publications } from '@/data/publications';
import { timeline } from '@/data/timeline';
import { awards, skillGroups } from '@/data/skills';
import { basePath } from '@/utils/base';
---

<BaseLayout title="Résumé · Ruibin Chen" description="Print-friendly résumé for Ruibin Chen, wireless systems researcher and PhD student at NYU Tandon.">
  <section class="resume-page">
    <div class="container resume-toolbar no-print">
      <div>
        <p class="eyebrow">Print-friendly résumé</p>
        <p>Use your browser’s print dialog to save this page as PDF, or open the supplied full CV.</p>
      </div>
      <div>
        <button type="button" onclick="window.print()">Print this page</button>
        <a href={`${basePath}${profile.cvPath}`} target="_blank" rel="noopener noreferrer">Open full CV ↗</a>
      </div>
    </div>

    <article class="container resume-sheet">
      <header class="resume-header">
        <div>
          <h1>{profile.name}</h1>
          <p>{profile.role}</p>
          <p>{profile.affiliation}</p>
        </div>
        <address>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span>{profile.location}</span>
        </address>
      </header>

      <section class="resume-summary">
        <h2>Profile</h2>
        <p>{profile.bio}</p>
      </section>

      <section>
        <h2>Experience & education</h2>
        <div class="resume-entries">
          {timeline.map((entry) => (
            <article class="resume-entry">
              <div><strong>{entry.title}</strong><span>{entry.organization}{entry.location && <> · {entry.location}</>}</span>{entry.description && <p>{entry.description}</p>}</div>
              <time>{entry.period}</time>
            </article>
          ))}
        </div>
      </section>

      <section>
        <h2>Selected research & engineering</h2>
        <div class="resume-entries">
          {projects.map((project) => (
            <article class="resume-entry">
              <div><strong>{project.title}</strong><span>{project.status} · {project.technologies.join(', ')}</span><p>{project.description}</p></div>
              <time>{project.period}</time>
            </article>
          ))}
        </div>
      </section>

      <section>
        <h2>Publications</h2>
        <ol class="resume-publications">
          {publications.map((publication) => (
            <li><strong>{publication.title}.</strong> {publication.authors}. <em>{publication.venue}</em>, {publication.year}.{publication.status ? ` ${publication.status}.` : ''}</li>
          ))}
        </ol>
      </section>

      <div class="resume-two-column">
        <section>
          <h2>Skills</h2>
          {skillGroups.map((group) => <p class="skill-line"><strong>{group.title}:</strong> {group.items.join(', ')}</p>)}
        </section>
        <section>
          <h2>Awards</h2>
          {awards.map((award) => <p class="award-line"><strong>{award.title}</strong><br />{award.organization} · {award.year}</p>)}
        </section>
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .resume-page { padding: 3rem 0 6rem; }
  .resume-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 2rem; margin-bottom: 2rem; }
  .resume-toolbar p:last-child { margin-top: .35rem; color: var(--text-muted); }
  .resume-toolbar > div:last-child { display: flex; gap: .6rem; }
  .resume-toolbar button, .resume-toolbar a { padding: .7rem 1rem; border: 1px solid var(--border-strong); border-radius: .4rem; background: var(--surface-raised); color: var(--text); font-size: .78rem; font-weight: 700; text-decoration: none; cursor: pointer; }
  .resume-sheet { max-width: 960px; padding: clamp(2rem, 6vw, 4.5rem); border: 1px solid var(--border); border-radius: .75rem; background: var(--surface-raised); box-shadow: var(--shadow-sm); }
  .resume-header { display: flex; justify-content: space-between; gap: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--text); }
  .resume-header h1 { font-size: clamp(2.6rem, 7vw, 4.5rem); }
  .resume-header p { margin-top: .35rem; color: var(--text-muted); }
  address { display: grid; align-content: end; justify-items: end; gap: .3rem; color: var(--text-muted); font-size: .85rem; font-style: normal; }
  .resume-sheet section { margin-top: 2rem; }
  .resume-sheet h2 { margin-bottom: 1rem; padding-bottom: .35rem; border-bottom: 1px solid var(--border); color: var(--accent-strong); font-family: var(--font-mono); font-size: .78rem; letter-spacing: .11em; text-transform: uppercase; }
  .resume-summary p, .resume-entry p, .resume-publications li, .skill-line, .award-line { color: var(--text-muted); line-height: 1.55; }
  .resume-entry { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; padding: .75rem 0; }
  .resume-entry strong, .resume-entry span { display: block; }
  .resume-entry span, .resume-entry time { color: var(--text-muted); font-size: .82rem; }
  .resume-entry p { margin-top: .35rem; font-size: .84rem; }
  .resume-entry time { font-family: var(--font-mono); font-size: .7rem; white-space: nowrap; }
  .resume-publications { margin: 0; padding-left: 1.2rem; }
  .resume-publications li { padding: .4rem 0 .4rem .4rem; font-size: .84rem; }
  .resume-two-column { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .skill-line, .award-line { margin-top: .55rem; font-size: .82rem; }

  @media (max-width: 650px) {
    .resume-toolbar, .resume-header { display: block; }
    .resume-toolbar > div:last-child { margin-top: 1rem; }
    address { justify-items: start; margin-top: 1rem; }
    .resume-entry { grid-template-columns: 1fr; gap: .25rem; }
    .resume-two-column { grid-template-columns: 1fr; gap: 0; }
  }

  @media print {
    .resume-page { padding: 0; }
    .resume-sheet { width: 100%; max-width: none; padding: 0; border: 0; box-shadow: none; }
    .resume-header h1 { font-size: 28pt; }
    .resume-sheet section { margin-top: 14pt; break-inside: avoid; }
    .resume-entry { padding: 4pt 0; break-inside: avoid; }
    .resume-publications li { padding-block: 3pt; }
  }
</style>
